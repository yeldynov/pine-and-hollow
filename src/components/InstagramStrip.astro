---
import { Image } from 'astro:assets';
import { site } from '../data/site';

const { handle, href, images } = site.instagram;
---

<section aria-label="Instagram" class="bg-linen">
  <p class="py-8 text-center">
    <a href={href} class="text-nav font-medium uppercase text-ink transition-colors hover:text-stone">{handle}</a>
  </p>
  <ul class="grid grid-cols-3 md:grid-cols-6">
    {images.map((img) => (
      <li>
        <Image
          src={img.src}
          alt={img.alt}
          widths={[240, 480]}
          sizes="(min-width: 768px) 17vw, 34vw"
          class="aspect-square size-full object-cover"
        />
      </li>
    ))}
  </ul>
</section>
