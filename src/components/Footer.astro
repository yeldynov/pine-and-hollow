---
import { site } from '../data/site';

const { links, address, email, phone, language } = site.footer;
const small = 'text-nav font-medium uppercase text-ink';
---

<footer id="contact" class="bg-linen">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 text-center md:grid-cols-3 md:text-left lg:px-16">
    <ul class="flex flex-col gap-5">
      {links.map((link) => (
        <li><a href={link.href} class:list={[small, 'transition-colors hover:text-stone']}>{link.label}</a></li>
      ))}
    </ul>

    <a href="/" class="justify-self-center font-display text-logo text-ink">
      Pine <em>&amp;</em> Hollow
    </a>

    <div class="space-y-4 text-xs leading-relaxed text-ink md:justify-self-end">
      <address class="not-italic">
        {address.map((line) => <span class="block">{line}</span>)}
      </address>
      <p>
        <a href={`mailto:${email}`} class="block py-1 hover:text-stone">{email}</a>
        <a href={`tel:${phone.replace(/\s/g, '')}`} class="block py-1 hover:text-stone">{phone}</a>
      </p>
      <!-- Plain text until there's a second language; then make it a <select> -->
      <p class={small}>{language}</p>
    </div>
  </div>
</footer>
